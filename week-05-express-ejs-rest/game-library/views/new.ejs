<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Game</title>
</head>

<body>
    <h1>New Game</h1>
    <form action="/games" method="POST">
        <label for="idTitle">Add Title:</label>
        <input type="text" id="idTitle" name="title" placeholder="title..." required>
        <br>
        <label for="idGenre">Add Genre:</label>
        <input type="text" id="idGenre" name="genre" placeholder="genre..." required>
        <br>
        <button type="submit">Add Game</button>
    </form>
    <a href="/games" title="BACK">&larr; Back to Library</a>
</body>

</html>